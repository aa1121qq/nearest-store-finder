# انسخ هذا الملف إلى .env.local للتجربة المحلية (npx vercel dev).
# في الإنتاج: أضف نفس المفاتيح في Vercel Dashboard → Settings → Environment Variables.
# لا تضع المفاتيح الحقيقية هنا — هذا الملف مجرد قالب.

SEBL_API_KEY=your-sebl-subscription-key-here

# مفتاح Google Maps (لخريطة تحديد الموقع في صفحة الدفع).
# فعّل في Google Cloud: Maps JavaScript API + Places API + Geocoding API.
# المفتاح يظهر في المتصفّح (طبيعي) — أمّنه بتقييد HTTP referrer على نطاق موقعك.
GOOGLE_MAPS_API_KEY=
