# انسخ هذا الملف إلى .env.local للتجربة المحلية (npx vercel dev).
# في الإنتاج: أضف نفس المفاتيح في Vercel Dashboard → Settings → Environment Variables.
# لا تضع المفاتيح الحقيقية هنا — هذا الملف مجرد قالب.

SEBL_API_KEY=your-sebl-subscription-key-here

# اختياري: مفتاح خريطة العنوان الوطني (Maps API).
# إن تركته فارغاً سيُستخدم SEBL_API_KEY نفسه تلقائياً.
# ملاحظة: مفتاح الخريطة يظهر في طرف العميل (هذا متأصّل في كل SDK خرائط).
# للإنتاج: قيّد المفتاح على نطاق موقعك من بوابة العنوان الوطني.
MAPS_API_KEY=
